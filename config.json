{
  "app": {
    "title": "Smart Financial Expense Tracker",
    "version": "1.0.0"
  },
  "paths": {
    "raw_dir": "data/raw",
    "processed_dir": "data/processed",
    "output_dir": "outputs",
    "log_file": "logs/app.log"
  },
  "schema": {
    "required_columns": ["date", "category", "amount"],
    "optional_columns": ["transaction_id", "description", "payment_method"]
  },
  "cleaning": {
    "missing_value_strategy": "drop_critical",
    "outlier_iqr_multiplier": 1.5,
    "date_format": "%Y-%m-%d"
  },
  "visualization": {
    "color_palette": "viridis",
    "primary_color": "#2E86AB",
    "figure_dpi": 100,
    "export_dpi": 300,
    "figure_size": [10, 6]
  },
  "ml": {
    "random_seed": 42,
    "batch_size": 32,
    "epochs": 50,
    "learning_rate": 0.001
  }
}